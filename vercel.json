{
  "alias": ["noctra-tv.vercel.app"],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/catalog.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
