{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/intro.html" },
    { "source": "/app", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{server.mjs,src/**/*.mjs,public/api-snapshot/**,data/**}"
    }
  }
}
